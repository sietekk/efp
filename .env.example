# Copy to ~/.config/efp/.env and chmod 600 it. Never commit the copy.
# Every key below is self-serve (a signup form, no person involved). Leave a
# line blank to disable that source; `efp selftest` reports which are present.
# Names follow spec section 10; two aliases are noted.

# CourtListener REST API and RECAP: courtlistener.com -> free account -> profile -> API token
COURTLISTENER_TOKEN=

# api.data.gov key; one key serves both OpenFEC and the Congress.gov API: api.data.gov/signup
FEC_API_KEY=
CONGRESS_API_KEY=

# OpenStates: open.pluralpolicy.com -> account -> API key
OPENSTATES_KEY=

# Internet Archive S3-style keys for Save Page Now 2: archive.org/account/s3.php
IA_ACCESS=
IA_SECRET=

# Media Cloud: search.mediacloud.org -> sign up -> profile -> API token
MEDIACLOUD_KEY=

# Anthropic API, for extraction and the OCR fallback: console.anthropic.com -> API keys
# (the spec calls this LLM_API_KEY; the code reads ANTHROPIC_API_KEY because the SDK does)
ANTHROPIC_API_KEY=

# Optional: Google Programmable Search for pre-2017 discovery (100 queries/day free)
# programmablesearchengine.google.com (engine id) + a Google Cloud API key
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Not used in the first pass (applications, fees or emails are needed; see docs/plan.md,
# "Excluded from the first pass"). Listed so the variable names are fixed. Leave blank.
PACER_USER=
PACER_PASS=
PERMA_API_KEY=
